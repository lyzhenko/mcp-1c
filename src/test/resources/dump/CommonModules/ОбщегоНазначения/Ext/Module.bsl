// Суммирует значения.
Функция СуммаСтрокой(Значения) Экспорт
	Результат = 0;
	Для Каждого Значение Из Значения Цикл
		Результат = Результат + Значение;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьТовары(Товары) Экспорт
	Товары.Очистить();
КонецПроцедуры

