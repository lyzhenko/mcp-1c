// Суммирует значения.
Функция СуммаСтрокой(Значения) Экспорт
	Результат = 0;
	Для Каждого Значение Из Значения Цикл
		Результат = Результат + Значение;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьТовары(Товары) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ Справочник.Товары КАК Товары";
	Товары.Очистить();
КонецПроцедуры

